---
import Base from "../layouts/Base.astro";
import SectionRule from "../components/SectionRule.astro";
import { m } from "../theme";
import { getCopy } from "../i18n";
import { appLink, NYC_PRESET } from "../lib/site";
import { localePath, type Locale } from "../lib/links";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale);
const n = t.nyc;
/** Date the legal summary below was last checked against DCWP material. Update when the copy changes. */
const REVIEWED_ON = "2026-09-22";
const statusLabel = (s: string) => (s === "enforced" ? n.enforced : n.roadmap);
const statusClass = (s: string) => (s === "enforced" ? `${m.text.clear}` : "text-ink/60");
---
<Base locale={locale} title={`${n.metaTitle} | ${t.common.appName}`} description={n.metaDesc} path="/nyc-fair-workweek-scheduling">
  <main class="max-w-[92rem] mx-auto px-6">
    <section class="pt-16 pb-16 max-w-[62ch]">
      <p class={`${m.text.meta} mb-6`}>{n.eyebrow}</p>
      <h1 class={`${m.text.display} font-display text-5xl sm:text-6xl font-semibold leading-[0.95] mb-6`}>
        {n.title} <span class={m.mark}>{n.titleAccent}</span>
      </h1>
      <p class={`${m.text.muted} text-lg leading-relaxed mb-9`}>{n.intro}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={localePath(locale, "/free-schedule-checker")} class={m.btn.primary}>{n.ctaChecker}</a>
        <a href={appLink("/register", NYC_PRESET)} class={m.btn.link}>{n.ctaSignup}</a>
      </div>
    </section>

    <SectionRule eyebrow={n.coveredEyebrow} title={n.coveredTitle} />
    <div class={`grid gap-px md:grid-cols-2 bg-rule border ${m.rule.line} mb-24`}>
      <div class="bg-newsprint p-6">
        <h3 class={`${m.text.display} font-display text-2xl font-semibold mb-3`}>{n.fastFoodTitle}</h3>
        <p class={`${m.text.muted} leading-relaxed`}>{n.fastFoodDesc}</p>
      </div>
      <div class="bg-newsprint p-6">
        <h3 class={`${m.text.display} font-display text-2xl font-semibold mb-3`}>{n.retailTitle}</h3>
        <p class={`${m.text.muted} leading-relaxed`}>{n.retailDesc}</p>
      </div>
    </div>

    <SectionRule eyebrow={n.rulesEyebrow} />
    <div class="grid gap-10 md:grid-cols-2 mb-24">
      <div>
        <p class={`${m.text.meta} mb-4`}>{n.fastFoodRulesTitle}</p>
        <dl class={`border-t ${m.rule.line}`}>
          {n.fastFoodRules.map((r) => (
            <div class={`border-b ${m.rule.line} py-4`}>
              <dt class={`${m.text.body} font-medium`}>{r.title}</dt>
              <dd class={`${m.text.muted} text-sm leading-relaxed`}>{r.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <p class={`${m.text.meta} mb-4`}>{n.retailRulesTitle}</p>
        <dl class={`border-t ${m.rule.line}`}>
          {n.retailRules.map((r) => (
            <div class={`border-b ${m.rule.line} py-4`}>
              <dt class={`${m.text.body} font-medium`}>{r.title}</dt>
              <dd class={`${m.text.muted} text-sm leading-relaxed`}>{r.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <SectionRule eyebrow={n.premiumsEyebrow} title={n.premiumsTitle} />
    <div class={`${m.surface} border ${m.rule.heavy} p-6 md:p-10 max-w-3xl mb-10`}>
      <div class="overflow-x-auto">
        <table class="w-full font-data text-sm tabular-nums">
          <thead>
            <tr class={`border-b ${m.rule.line}`}>
              <th class={`${m.text.meta} text-start pb-3`}>{n.premiumsNotice}</th>
              <th class={`${m.text.meta} text-end pb-3`}>{n.premiumsAdded}</th>
              <th class={`${m.text.meta} text-end pb-3`}>{n.premiumsReduced}</th>
            </tr>
          </thead>
          <tbody>
            {n.premiums.map((p) => (
              <tr class={`border-b ${m.rule.grid}`}>
                <td class="py-2.5 text-start">{p.notice}</td>
                <td class="py-2.5 text-end">{p.added}</td>
                <td class="py-2.5 text-end">{p.reduced}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class={`border ${m.rule.line} p-6 md:p-8 max-w-3xl mb-24`}>
      <p class={`${m.text.meta} mb-3`}>{n.finesTitle}</p>
      <p class={`${m.text.muted} max-w-[60ch]`}>{n.finesDesc}</p>
    </div>

    <SectionRule eyebrow={n.productEyebrow} title={n.productTitle} />
    <dl class={`border-t ${m.rule.line} mb-24`}>
      {n.productRows.map((r) => (
        <div class={`border-b ${m.rule.line} py-4 grid gap-1 md:grid-cols-[18rem_8rem_1fr] md:gap-8`}>
          <dt class={`${m.text.body} font-medium`}>{r.title}</dt>
          <dd class={`${m.text.meta} ${statusClass(r.status)}`}>{statusLabel(r.status)}</dd>
          <dd class={`${m.text.muted} text-sm leading-relaxed`}>{r.desc}</dd>
        </div>
      ))}
    </dl>

    {/* Detailed Rule Explanations */}
    <SectionRule eyebrow="Deep Dive" title="Understanding Each Rule" />
    <div class="max-w-3xl mb-24">
      <div class="space-y-12">
        <div>
          <h3 class={`${m.text.display} text-2xl font-semibold mb-4`}>11-Hour Rest Requirement</h3>
          <p class={`${m.text.muted} text-base leading-relaxed mb-4`}>
            Workers must have at least 11 consecutive hours off between shifts. This rule applies regardless of shift length or when shifts occur.
          </p>
          <div class={`${m.surface} border ${m.rule.line} p-4 mb-4`}>
            <p class={`${m.text.meta} font-medium mb-2`}>Example:</p>
            <p class={`${m.text.muted} text-sm`}>If a worker's shift ends at 10 PM on Monday, they cannot start work until 9 AM on Tuesday (11 hours later). Starting them at 9:01 AM violates the rule.</p>
          </div>
          <p class={`${m.text.muted} text-base`}>
            This protects worker health and prevents fatigue-related errors, especially critical in fast food and retail environments where mistakes can be costly.
          </p>
        </div>

        <div>
          <h3 class={`${m.text.display} text-2xl font-semibold mb-4`}>14-Day Advance Notice</h3>
          <p class={`${m.text.muted} text-base leading-relaxed mb-4`}>
            Schedule changes must be communicated at least 14 calendar days before the shift. This applies to all schedule changes—additions, removals, or modifications.
          </p>
          <div class={`${m.surface} border ${m.rule.line} p-4 mb-4`}>
            <p class={`${m.text.meta} font-medium mb-2`}>Example:</p>
            <p class={`${m.text.muted} text-sm`}>If you're scheduling for the week of October 20, you must finalize the schedule by October 6 (14 days prior). Last-minute changes are only allowed in genuine emergencies.</p>
          </div>
          <p class={`${m.text.muted} text-base`}>
            This gives workers time to arrange childcare, transportation, and other commitments, reducing no-shows and improving workforce stability.
          </p>
        </div>

        <div>
          <h3 class={`${m.text.display} text-2xl font-semibold mb-4`}>Clopening Restrictions</h3>
          <p class={`${m.text.muted} text-base leading-relaxed mb-4`}>
            A "clopening" is a shift that closes the store one day and opens it the next. These are prohibited unless the worker explicitly agrees and receives premium pay.
          </p>
          <div class={`${m.surface} border ${m.rule.line} p-4 mb-4`}>
            <p class={`${m.text.meta} font-medium mb-2`}>Example:</p>
            <p class={`${m.text.muted} text-sm`}>A worker closes at 11 PM Friday and is scheduled to open at 6 AM Saturday. This is a clopening and requires explicit opt-in and $100 premium pay (as of 2026).</p>
          </div>
          <p class={`${m.text.muted} text-base`}>
            Clopenings cause extreme fatigue and burnout. The premium requirement incentivizes managers to minimize them, improving employee wellbeing.
          </p>
        </div>
      </div>
    </div>

    {/* Frequently Asked Questions */}
    <SectionRule eyebrow="Common Questions" title="NYC Fair Workweek FAQ" />
    <div class="max-w-3xl mb-24">
      <div class="space-y-8">
        <div>
          <h3 class="font-semibold text-lg mb-3">What counts as a "schedule change"?</h3>
          <p class={`${m.text.muted} text-base`}>
            Any modification to a published schedule: adding a shift, removing a shift, changing the time, swapping days, or adjusting duration. The 14-day notice applies to all of these.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-3">What's an emergency exception?</h3>
          <p class={`${m.text.muted} text-base`}>
            Genuine emergencies (worker no-shows, natural disasters, public health crises) allow last-minute changes without the 14-day notice. However, this must be truly exceptional, not routine.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-3">How is the 11-hour rest calculated?</h3>
          <p class={`${m.text.muted} text-base`}>
            It's 11 consecutive hours off, including sleep time. If a shift ends at 10 PM, the worker must be off until 9 AM the next day. Overlapping by even 1 minute violates the rule.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-3">What penalties apply if rules are broken?</h3>
          <p class={`${m.text.muted} text-base`}>
            NYC Department of Consumer and Worker Protection (DCWP) can fine employers up to $500 per violation per employee per day. Willful violations can exceed $1,000. Workers also have the right to sue.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-3">Does Wiz Scheduler enforce these rules?</h3>
          <p class={`${m.text.muted} text-base`}>
            Yes. Our scheduler prevents violations by blocking schedules that would break the 11-hour rule, enforcing 14-day advance notice, and flagging clopenings. You can still override if needed, but you'll be explicitly warned.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-3">How do I know if I'm compliant?</h3>
          <p class={`${m.text.muted} text-base`}>
            Use our free Fair Workweek checker above. Upload your schedule and we'll scan it for violations. It takes 30 seconds and covers all three rules.
          </p>
        </div>
      </div>
    </div>

    <SectionRule eyebrow={n.ctaEyebrow} title={n.ctaTitle} />
    <div class="max-w-2xl mb-16">
      <p class={`${m.text.muted} text-lg mb-8 max-w-[55ch]`}>{n.ctaDesc}</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href={localePath(locale, "/free-schedule-checker")} class={m.btn.primary}>{n.ctaChecker}</a>
        <a href={appLink("/register", NYC_PRESET)} class={m.btn.link}>{n.ctaSignup}</a>
      </div>
    </div>

    <p class={`${m.text.meta} mb-2`}>{n.reviewedOn} <time datetime={REVIEWED_ON}>{REVIEWED_ON}</time></p>
    <p class={`${m.text.muted} text-sm mb-8`}>
      <a href={n.sourceUrl} rel="noopener" target="_blank" class={m.btn.link}>{n.source}</a>
    </p>
  </main>
</Base>
