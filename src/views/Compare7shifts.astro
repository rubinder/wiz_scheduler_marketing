---
import Base from "../layouts/Base.astro";
import SectionRule from "../components/SectionRule.astro";
import { m } from "../theme";
import { appLink } from "../lib/site";
import { localePath, type Locale } from "../lib/links";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (p: string) => localePath(locale, p);

// Every competitor fact below comes from that vendor's own pricing page or
// help center, read on CHECKED_ON. Re-check them before changing this date;
// do not add a claim that has no source in `sources`.
const CHECKED_ON = "2026-11-04";

interface Tool {
  name: string;
  description: string;
  pricing: string;
  autoScheduling: string;
  preferences: string;
  fairWorkweek: string;
  pros: string[];
  cons: string[];
  sources: { label: string; href: string }[];
}

const tools: Tool[] = [
  {
    name: "Wiz Scheduler",
    description: "Generates the week from availability, roles, skill levels and each employee's preferences",
    pricing: "Free (2 locations, 25 employees); Pro $18/month for every location",
    autoScheduling: "Normal Generate on every plan; AI Generate on Pro, paid from prepaid credits",
    preferences: "Preferred days, preferred hours, max hours, shift caps, and who to work with or keep apart",
    fairWorkweek: "Minimum rest between shifts, set per location. No notice or premium-pay tracking",
    pros: [
      "Employee preferences go into the generator, not into a note the manager has to remember (employee requests are off until you turn them on)",
      "Any shift that goes against a preference is marked, so you see every compromise",
      "One $18 base price for all locations, with 500 employees included",
      "Importers for 7shifts and Deputy on the paid plan",
      "Employee pages in 19 languages",
    ],
    cons: [
      "No POS integration or sales forecasting",
      "No time clock beyond QR check-in, and no tip pooling",
      "Fair Workweek support is limited to the rest rule",
      "Newer product with a smaller user base",
    ],
    sources: [{ label: "Wiz Scheduler pricing", href: "/pricing" }],
  },
  {
    name: "7shifts",
    description: "Restaurant scheduling, time clock, tips and payroll",
    pricing: "Free Comp plan (1 location, 15 employees); paid plans $49.99 to $199.99 per location per month",
    autoScheduling: "Auto-scheduler in beta, rolling out to selected accounts; drafts from past sales and schedules",
    preferences: "Uses approved availability and time off. Its documentation does not mention shift or coworker preferences",
    fairWorkweek: "Yes: flags clopens, changes inside 14 days, and premium pay (paid plans)",
    pros: [
      "Deep POS integrations feed sales into labor targets",
      "Time clock, tip pooling and a payroll add-on",
      "NYC Fair Workweek alerts",
      "Large user base and mature mobile app",
    ],
    cons: [
      "Priced per location, so cost grows with every site",
      "Auto-scheduler needs six weeks of sales and schedule history",
      "Payroll is an extra $39.99 per location plus $6 per employee",
    ],
    sources: [
      { label: "7shifts pricing", href: "https://www.7shifts.com/pricing/" },
      { label: "7shifts auto-scheduler", href: "https://kb.7shifts.com/hc/en-us/articles/4417505384979" },
      { label: "7shifts Fair Workweek", href: "https://kb.7shifts.com/hc/en-us/articles/4417504944403" },
    ],
  },
  {
    name: "Deputy",
    description: "Workforce management with scheduling, time and attendance",
    pricing: "No free plan; $5 to $10 per user per month, $30 monthly minimum",
    autoScheduling: "Core and Pro plans; fills shifts by cost, equal hours, or learning from your past schedules",
    preferences: "Its auto-fill documentation does not mention employee shift or coworker preferences",
    fairWorkweek: "Yes: the most complete of these tools, including change consent, premiums and rest alerts",
    pros: [
      "Strong NYC Fair Workweek support",
      "Demand-based shift building from sales or custom metrics",
      "Time and attendance with geo check-in",
      "Large integration catalog",
    ],
    cons: [
      "Priced per user, so cost grows with every hire",
      "Auto-scheduling is not on the Lite plan",
      "Reviewers report a steep setup for complex rosters",
    ],
    sources: [
      { label: "Deputy pricing", href: "https://www.deputy.com/pricing" },
      { label: "Deputy auto-scheduling", href: "https://help.deputy.com/hc/en-au/articles/4688892429839-Using-Auto-scheduling" },
      { label: "Deputy Fair Workweek", href: "https://help.deputy.com/hc/en-au/articles/8433876310543" },
    ],
  },
  {
    name: "Homebase",
    description: "Scheduling, time clock and payroll for small teams",
    pricing: "Free Basic plan (1 location, 10 employees); paid plans $24 to $120 per location per month",
    autoScheduling: "AI scheduling assistant from the Plus plan",
    preferences: "Its marketing says it uses availability and preferred shifts",
    fairWorkweek: "We could not find NYC Fair Workweek features",
    pros: [
      "Generous free plan for one small location",
      "Simple interface",
      "Time clock and timesheets included",
    ],
    cons: [
      "Priced per location",
      "Auto-scheduling needs the Plus plan or higher",
      "No documented NYC Fair Workweek tools",
    ],
    sources: [
      { label: "Homebase pricing", href: "https://www.joinhomebase.com/pricing" },
      { label: "Homebase auto-scheduling", href: "https://www.joinhomebase.com/employee-scheduling/auto-scheduling" },
    ],
  },
  {
    name: "When I Work",
    description: "Scheduling and team messaging for hourly teams",
    pricing: "No free plan; $2.50 per user per month (one location) or $5 (multiple locations)",
    autoScheduling: "Auto-assign included on every plan",
    preferences: "Can require shifts to overlap an employee's preferred availability and respect max hours",
    fairWorkweek: "We could not find NYC Fair Workweek features",
    pros: [
      "Low per-user price for a single location",
      "Auto-assign included on every plan",
      "Simple scheduling and team chat",
    ],
    cons: [
      "Priced per user, doubling for multiple locations",
      "No coworker preferences",
      "No documented NYC Fair Workweek tools",
    ],
    sources: [
      { label: "When I Work pricing", href: "https://wheniwork.com/pricing" },
      { label: "When I Work auto-assign", href: "https://help.wheniwork.com/articles/auto-assign-shifts" },
    ],
  },
];

// Worked example: 3 locations, 40 employees, monthly billing, list prices on CHECKED_ON.
const example = [
  { name: "7shifts Pro", cost: "$299.97", how: "3 locations × $99.99" },
  { name: "Deputy Core", cost: "$290.00", how: "40 users × $7.25" },
  { name: "When I Work", cost: "$200.00", how: "40 users × $5.00 (multiple locations)" },
  { name: "Homebase Essentials", cost: "$90.00", how: "3 locations × $30.00 (no auto-scheduling on this plan)" },
  { name: "Wiz Scheduler Pro", cost: "$18.00", how: "base price; AI Generate credits are extra if you use them" },
];

const title = "7shifts Alternatives: Pricing and Auto-Scheduling Compared";
const description =
  "7shifts, Deputy, Homebase, When I Work and Wiz Scheduler side by side: current pricing, how each auto-schedules, whether it uses employee preferences, and NYC Fair Workweek support.";
---
<Base locale={locale} title={title} description={description} path={L("/compare/7shifts-alternatives")}>
  <main class="max-w-[92rem] mx-auto px-6">
    <section class="pt-12 lg:pt-20 pb-16">
      <div class="max-w-[62ch]">
        <h1 class={`${m.text.display} font-display text-5xl lg:text-6xl font-semibold leading-[0.95] mb-6`}>
          7shifts Alternatives
        </h1>
        <p class={`${m.text.muted} text-lg leading-relaxed max-w-[62ch]`}>
          Most scheduling tools can now draft a week for you. They differ in what they draft it from: sales history, labor cost, availability, or what your employees actually asked for. Here is how five tools compare, with prices taken from each vendor's own site.
        </p>
        <p class={`${m.text.meta} mt-4`}>
          Prices and features checked on <time datetime={CHECKED_ON}>{CHECKED_ON}</time>. See the sources under each tool.
        </p>
      </div>
    </section>

    <section class="pb-24">
      <SectionRule eyebrow="Side by Side" title="Feature Comparison" />
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class={`border-b ${m.rule.line}`}>
              <th class="text-start font-semibold pb-3 pe-4">Tool</th>
              <th class="text-start pb-3 px-2">Auto-scheduling</th>
              <th class="text-start pb-3 px-2">Employee preferences</th>
              <th class="text-start pb-3 px-2">NYC Fair Workweek</th>
              <th class="text-start pb-3 ps-4">Pricing</th>
            </tr>
          </thead>
          <tbody>
            {tools.map((tool) => (
              <tr class={`border-b ${m.rule.line} align-top`}>
                <td class="py-3 pe-4 font-medium">{tool.name}</td>
                <td class="py-3 px-2">{tool.autoScheduling}</td>
                <td class="py-3 px-2">{tool.preferences}</td>
                <td class="py-3 px-2">{tool.fairWorkweek}</td>
                <td class="py-3 ps-4">{tool.pricing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pb-24 max-w-3xl">
      <SectionRule eyebrow="Worked Example" title="Three locations, forty employees" />
      <p class={`${m.text.muted} text-base mb-6`}>
        Monthly list prices on {CHECKED_ON}, before taxes, add-ons and annual discounts.
      </p>
      <table class="w-full text-sm">
        <tbody>
          {example.map((row) => (
            <tr class={`border-b ${m.rule.line}`}>
              <td class="py-3 pe-4 font-medium">{row.name}</td>
              <td class="py-3 px-2 text-end font-semibold">{row.cost}</td>
              <td class={`py-3 ps-4 ${m.text.muted}`}>{row.how}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="pb-24">
      <SectionRule eyebrow="Detailed" title="Platform Breakdown" />
      <div class="space-y-12">
        {tools.map((tool) => (
          <div class={`${m.surface} border ${m.rule.line} p-8`}>
            <h3 class={`${m.text.display} text-2xl font-semibold mb-1`}>{tool.name}</h3>
            <p class={`${m.text.muted} text-sm mb-3`}>{tool.description}</p>
            <p class={`${m.text.body} font-semibold text-lg mb-6`}>{tool.pricing}</p>
            <div class="grid md:grid-cols-2 gap-8">
              <div>
                <h4 class="font-semibold mb-3 text-green-700">Strengths</h4>
                <ul class="space-y-2">
                  {tool.pros.map((pro) => (
                    <li class={`${m.text.muted} text-sm flex gap-2`}>
                      <span class="flex-shrink-0">✓</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold mb-3 text-red-700">Limitations</h4>
                <ul class="space-y-2">
                  {tool.cons.map((con) => (
                    <li class={`${m.text.muted} text-sm flex gap-2`}>
                      <span class="flex-shrink-0">✗</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <p class={`${m.text.meta} mt-6`}>
              Sources:{" "}
              {tool.sources.map((s, i) => (
                <>
                  {i > 0 && " · "}
                  <a
                    href={s.href.startsWith("/") ? L(s.href) : s.href}
                    rel={s.href.startsWith("/") ? undefined : "noopener nofollow"}
                    target={s.href.startsWith("/") ? undefined : "_blank"}
                    class={m.btn.link}
                  >{s.label}</a>
                </>
              ))}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="max-w-3xl pb-24">
      <SectionRule eyebrow="Why Wiz Scheduler" title="The Key Differences" />
      <div class="space-y-6">
        <div>
          <h3 class="font-semibold text-lg mb-2">Built from what your team asked for</h3>
          <p class={`${m.text.muted} text-base`}>
            Managers can record each employee's preferred days, preferred hours, weekly hour limit, and who they work well with or should be kept apart from. Turn on preference requests and employees can ask for these themselves, for a manager to approve. The generator then uses them: a firm rule keeps someone off a shift entirely, a softer one makes them a less likely pick. When a preference can't be met, that shift is marked so you can see it, and a shift nobody can fill without breaking a firm rule is left open rather than forced.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">One price for every location</h3>
          <p class={`${m.text.muted} text-base`}>
            Pro is $18 a month for all your locations, with 500 employees, 50 manager seats and 25 schedule generations included. Above those there are small metered charges. AI Generate is optional and paid from prepaid credits.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Rest between shifts, enforced</h3>
          <p class={`${m.text.muted} text-base`}>
            Set a minimum rest, such as 11 hours, on a location and no generated schedule will break it. That is the extent of our Fair Workweek support today: if you need advance-notice tracking or premium-pay calculation, 7shifts and Deputy do more here.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Bring your team over</h3>
          <p class={`${m.text.muted} text-base`}>
            The paid plan imports locations, roles, employees and availability from 7shifts or Deputy using an API token from your account there.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Your data stays yours</h3>
          <p class={`${m.text.muted} text-base`}>
            Employee names are replaced with stand-ins before anything is sent to the AI model.
          </p>
        </div>
      </div>
    </section>

    <section class={`max-w-3xl mb-16 pb-16 border-t ${m.rule.line}`}>
      <h2 class={`${m.text.display} text-2xl font-semibold mb-4 mt-12`}>Try it on your own team</h2>
      <p class={`${m.text.muted} text-base mb-8`}>
        The free plan covers 2 locations and 25 employees, with no credit card.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={appLink("/register")} class={m.btn.primary}>Start Free</a>
        <a href={L("/compare/7shifts")} class={m.btn.link}>Wiz Scheduler vs 7shifts</a>
        <a href={L("/free-schedule-checker")} class={m.btn.link}>Try the Compliance Checker</a>
      </div>
    </section>
  </main>
</Base>
