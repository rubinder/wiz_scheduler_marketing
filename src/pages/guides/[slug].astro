---
import { getCollection, type CollectionEntry } from "astro:content";
import Guide from "../../views/Guide.astro";
import { DEFAULT_LOCALE } from "../../lib/links";
import { splitId } from "../../lib/guides";

export async function getStaticPaths() {
  const entries = await getCollection("guides");
  return entries
    .map((entry) => ({ entry, ...splitId(entry.id) }))
    .filter((g) => g.locale === DEFAULT_LOCALE)
    .map((g) => ({ params: { slug: g.slug }, props: { entry: g.entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"guides"> };
---
<Guide locale={DEFAULT_LOCALE} entry={entry} />
